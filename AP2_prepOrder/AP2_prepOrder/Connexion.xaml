<UserControl x:Class="AP2_prepOrder.Connexion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AP2_prepOrder"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#2A2A2A">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Définition de 2 colonnes -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <GroupBox Width="450" Height="70">
            <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" FontWeight="Bold" Foreground="White">
                Connexion à Prep'Order
            </TextBlock>
        </GroupBox>
        <!-- Le StackPanel est centré horizontalement et verticalement dans la Grid -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="24" Foreground="White" Margin="0,0,0,15">
                Nom d'utilisateur
            </TextBlock>
            <TextBox Name="tbIdentifiant" Width="300" FontSize="20" Margin="0,0,0,15"></TextBox>
            <TextBlock HorizontalAlignment="Center" FontSize="24" Foreground="White" Margin="0,0,0,15">
                Mot de passe
            </TextBlock>
            <PasswordBox Name="tbMdp" Width="300" FontSize="20" Margin="0,0,0,15"></PasswordBox>
            <TextBlock Name="tbErreur" Visibility="Hidden" HorizontalAlignment="Center" FontSize="24" Foreground="Red" Margin="0,0,0,15">
            </TextBlock>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Name="btn_connexion" Content="Se connecter" Width="170" Height="70" Cursor="Hand" FontSize="20" FontWeight="Bold" Click="btn_connexion_Click" />
        </StackPanel>
    </Grid>
</UserControl>
